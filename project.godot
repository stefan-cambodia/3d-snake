; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3D Snake"
config/description="An immersive third-person 3D snake game set in an ancient lakeside sanctuary."
config/version="1.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.039, 0.055, 0.047, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/splash.png"
boot_splash/stretch_mode=0
config/icon="res://assets/icons/icon.svg"
config/quit_on_go_back=false

[autoload]

Profile="*res://scripts/save/profile.gd"
Localization="*res://scripts/core/localization.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.fr.translation", "res://assets/i18n/strings.km.translation", "res://assets/i18n/strings.th.translation", "res://assets/i18n/strings.es.translation", "res://assets/i18n/strings.pt_BR.translation", "res://assets/i18n/strings.de.translation", "res://assets/i18n/strings.it.translation", "res://assets/i18n/strings.tr.translation", "res://assets/i18n/strings.id.translation", "res://assets/i18n/strings.ru.translation", "res://assets/i18n/strings.ja.translation", "res://assets/i18n/strings.ko.translation", "res://assets/i18n/strings.zh_CN.translation")
locale/fallback="en"
locale/include_text_server_data=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.047, 1)
